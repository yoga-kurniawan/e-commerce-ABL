# Copy to .env, then fill four DIFFERENT passwords before starting Compose.
# This file is also sourced by the Bash helper: use KEY=value syntax.
# Single-quote values containing spaces, $, #, or !; avoid single quotes inside passwords.
COMPOSE_PROJECT_NAME=ecommerce-abl-local
POSTGRES_IMAGE=postgres:17
DB_HOST=127.0.0.1

PRODUCT_DB_NAME=product_db
PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=
PRODUCT_DB_PORT=5433
PRODUCT_SERVICE_PORT=8081

CART_DB_NAME=cart_db
CART_DB_USER=cart_user
CART_DB_PASSWORD=
CART_DB_PORT=5434
CART_SERVICE_PORT=8082

ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=
ORDER_DB_PORT=5435
ORDER_SERVICE_PORT=8083

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=
PAYMENT_DB_PORT=5436
PAYMENT_SERVICE_PORT=8084

