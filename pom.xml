<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>id.ac.ub.abl</groupId>
    <artifactId>ecommerce-microservices</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>17</java.version>
        <api.version>2.0.0</api.version>
    </properties>

    <modules>
        <module>services/security-support</module>
        <module>services/product-service</module>
        <module>services/cart-service</module>
        <module>services/order-service</module>
        <module>services/payment-service</module>
    </modules>
    <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration><environmentVariables>
            <!-- Existing business tests stay isolated; JWT tests explicitly enable security. -->
            <APP_SECURITY_ENABLED>false</APP_SECURITY_ENABLED>
        </environmentVariables></configuration>
    </plugin></plugins></build>
</project>
